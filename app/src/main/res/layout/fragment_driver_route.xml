<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dashboard"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Driver Route (Fragment)"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="You can migrate DriverRouteActivity UI here later."
        android:textColor="@color/grey_600"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="User: —"
        android:textColor="@color/grey_600"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_refreshed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Refreshed: —"
        android:textColor="@color/grey_600"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btn_open_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_outline_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:text="Open Route Page"
        android:textColor="@color/primaryColor"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_emergency_dial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_outline_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:text="Emergency Dial (0762306355)"
        android:textColor="@color/primaryColor"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>

